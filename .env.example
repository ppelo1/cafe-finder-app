# 네이버 장소 검색 프록시(server/index.js)용
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# 로컬 테스트 로그인: true 로 두면 SNS/Supabase 설정 없이
# "카카오/구글로 계속하기" 버튼이 바로 로컬 계정으로 로그인된다.
# 즐겨찾기는 그 계정 id 별로 localStorage 에 저장. (배포 시 false 로)
VITE_DEV_LOGIN=false

# Supabase (실제 로그인 + 즐겨찾기 DB) - 설정 방법은 docs/auth-setup.md
# Project Settings > API 에서 확인. VITE_DEV_LOGIN=true 면 없어도 됨.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
